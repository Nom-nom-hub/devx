{
  "name": "@devx-cli/devx",
  "version": "1.0.1",
  "description": "A TypeScript-based CLI tool for project management and task execution",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "devx": "bin/devx.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "node scripts/post-install.js",
    "version:patch": "node scripts/version.js patch",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major"
  },
  "keywords": ["cli", "devtools", "automation", "task-runner"],
  "author": "DevX-cli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nom-nom-hub/devx.git"
  },
  "homepage": "https://github.com/Nom-nom-hub/devx",
  "bugs": {
    "url": "https://github.com/Nom-nom-hub/devx/issues"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "inquirer": "^12.6.0",
    "js-yaml": "^4.1.0",
    "typescript": "^5.8.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.3",
    "tsup": "^8.4.0"
  }
}
